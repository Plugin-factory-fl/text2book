generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  name           String?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  business     Business?
  subscription Subscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Business {
  id                  String   @id @default(cuid())
  userId              String   @unique
  name                String
  category            String?
  description         String?  @db.Text
  phone               String?
  email               String?
  address             String?
  city                String?
  state               String?
  zipCode             String?
  timezone            String   @default("America/New_York")
  cancellationPolicy  String?  @db.Text
  reminderHoursBefore Int      @default(24)
  isActive            Boolean  @default(true)
  onboardingComplete  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Stripe Connect for receiving deposit payments
  stripeAccountId         String?  @unique
  stripeOnboardingComplete Boolean  @default(false)

  // Deposit settings
  depositsEnabled         Boolean  @default(false)
  defaultDepositAmount    Int?     // in cents (e.g. 1500 = $15)
  depositHoldMinutes      Int      @default(30)
  depositPolicyText       String?  @db.Text // e.g. "Deposit is non-refundable on no-show and applied toward your service"

  // Platform fee (configurable, 0 for now)
  platformFeePercent      Float    @default(0)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services          Service[]
  availabilityRules AvailabilityRule[]
  faqs              FAQ[]
  phoneNumber       PhoneNumber?
  bookings          Booking[]
  conversations     Conversation[]
  calendarConnection CalendarConnection?
  trustedClients    TrustedClient[]
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?  @db.Text
  duration    Int      // in minutes
  price       Float?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Per-service deposit override (null = use business default, 0 = no deposit required)
  depositOverride Int?     // in cents; null means use business default

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([businessId])
}

model AvailabilityRule {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int      // 0 = Sunday, 6 = Saturday
  startTime  String   // HH:MM format
  endTime    String   // HH:MM format
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model FAQ {
  id         String   @id @default(cuid())
  businessId String
  question   String
  answer     String   @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model PhoneNumber {
  id                String   @id @default(cuid())
  businessId        String   @unique
  twilioSid         String   @unique
  phoneNumber       String   @unique
  friendlyName      String?
  isActive          Boolean  @default(true)
  monthlySmsSent    Int      @default(0)
  monthlySmsCap     Int      @default(500)
  lastMonthlyReset  DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model CalendarConnection {
  id           String   @id @default(cuid())
  businessId   String   @unique
  provider     String   @default("google")
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  expiresAt    DateTime?
  calendarId   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Booking {
  id               String        @id @default(cuid())
  businessId       String
  serviceId        String?
  conversationId   String?
  clientName       String
  clientPhone      String
  clientEmail      String?
  serviceName      String        // denormalized for history
  duration         Int           // in minutes
  price            Float?
  startTime        DateTime
  endTime          DateTime
  calendarEventId  String?
  status           BookingStatus @default(CONFIRMED)
  notes            String?       @db.Text
  confirmationSent Boolean       @default(false)
  reminderSent     Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Deposit tracking
  depositRequired  Boolean       @default(false)
  depositAmount    Int?          // in cents
  depositStatus    DepositStatus @default(NOT_REQUIRED)
  depositPaidAt    DateTime?
  depositExpiresAt DateTime?     // when the hold expires if unpaid

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  depositPayment DepositPayment?

  @@index([businessId])
  @@index([startTime])
  @@index([clientPhone])
  @@index([depositExpiresAt])
}

enum BookingStatus {
  PENDING
  AWAITING_DEPOSIT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum DepositStatus {
  NOT_REQUIRED
  PENDING
  PAID
  EXPIRED
  REFUNDED
}

model Conversation {
  id           String             @id @default(cuid())
  businessId   String
  clientPhone  String
  clientName   String?
  state        ConversationState  @default(GREETING)
  context      Json?              // stores conversation context
  lastActivity DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages Message[]
  bookings Booking[]
  internalNotes InternalNote[]
  ownerDirectives OwnerDirective[]

  @@unique([businessId, clientPhone])
  @@index([businessId])
  @@index([clientPhone])
}

enum ConversationState {
  GREETING
  COLLECTING_SERVICE
  COLLECTING_TIME
  COLLECTING_NAME
  COLLECTING_DETAILS
  CONFIRMING
  BOOKING_COMPLETE
  FAQ
  RESCHEDULE
  CANCEL
  ESCALATE
  OWNER_TAKEOVER
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  direction      MessageDir
  content        String      @db.Text
  twilioSid      String?
  status         String?
  isAi           Boolean     @default(true)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum MessageDir {
  INBOUND
  OUTBOUND
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(TRIAL)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

model ScheduledReminder {
  id          String   @id @default(cuid())
  bookingId   String
  sendAt      DateTime
  sent        Boolean  @default(false)
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([sendAt, sent])
}

model TrustedClient {
  id          String   @id @default(cuid())
  businessId  String
  phone       String
  name        String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([phone])
}

model DepositPayment {
  id                    String   @id @default(cuid())
  bookingId             String   @unique
  stripeCheckoutSessionId String?  @unique
  stripePaymentIntentId String?  @unique
  amount                Int      // in cents
  status                String   @default("pending") // pending, paid, refunded, expired
  paidAt                DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
}

model InternalNote {
  id             String       @id @default(cuid())
  conversationId String
  noteType       NoteType     @default(CONSULT)
  content        String       @db.Text
  fromAgent      String
  toAgent        String?
  wasFiltered    Boolean      @default(false)
  filterReason   String?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([noteType])
}

enum NoteType {
  CONSULT
  RESPONSE
  ESCALATION
  DIRECTIVE
  INJECTION_ATTEMPT
}

model OwnerDirective {
  id             String   @id @default(cuid())
  conversationId String
  directive      String   @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  expiresAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([isActive])
}
