# Database
DATABASE_URL="postgresql://user:password@localhost:5432/text2book?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# Twilio
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBERS_POOL=""

# Google OAuth for Calendar
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenAI (for LLM conversation engine)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL_CLIENT="gpt-4.1-nano"
OPENAI_MODEL_OWNER="gpt-4.1-mini"

# Stripe
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"
STRIPE_PRICE_ID="your-stripe-price-id-for-19.99-monthly"
STRIPE_PRICE_ID_STARTER="price_text2book_starter_placeholder"
STRIPE_PRICE_ID_GROWTH="price_text2book_growth_placeholder"
STRIPE_PRICE_ID_PRO="price_text2book_pro_placeholder"

# App Config
APP_URL="http://localhost:3000"
TRIAL_DAYS="7"

# Cron Secret (for reminder job authentication)
CRON_SECRET="your-cron-secret"
